[project]
entrypoint = "index.html"
requires = [ "nodejs-24" ]
project_type = "web"
template = "native-static"
version = "0.0.32"
appliedPatches = [ ]

[dev]
build = [
  "sh",
  "-c",
  "echo 'Building...'"
]
run = [
  "node",
  "server.js"
]

[deploy]
build = [
  "sh",
  "-c",
  "echo 'Deploy build...'"
]
run = [
  "node",
  "server.js"
]
