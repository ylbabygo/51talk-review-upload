[project]
entrypoint = "index.html"
requires = [ "nodejs-24" ]
project_type = "web"
template = "native-static"
version = "0.0.32"
appliedPatches = [ ]

[dev]
build = [ ]
run = [
  "sh",
  "-c",
  "npx serve -l ${DEPLOY_RUN_PORT} -s ."
]

[deploy]
build = [ ]
run = [
  "sh",
  "-c",
  "npx serve -l ${DEPLOY_RUN_PORT} -s ."
]
